# Copy this file to .env and fill in real values. .env is never committed.

# "mock" runs the pipeline without an API key; "anthropic" calls the real model.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high
LLM_EFFORT=medium

# Secrets for endpoints that change data (X-API-Key header).
# API_KEY is for Power Automate; DEMO_PASSCODE is typed into the web page.
API_KEY=change-me-locally
DEMO_PASSCODE=loanlens-demo

# Power Automate approval flow trigger URL. Leave empty to simulate approvals locally.
APPROVAL_FLOW_URL=
FRONTEND_URL=http://localhost:5173

# Valuation age is measured against this date, not today.
ASSESSMENT_DATE=2026-11-01

# Defaults to a SQLite file in backend/. Azure SQL example:
# DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net/loanlens?driver=ODBC+Driver+18+for+SQL+Server
# DATABASE_URL=

# JSON list of front-end origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]
